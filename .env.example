# Optional: copy this file to .env to override the defaults.
# Without a .env file the project uses the defaults shown here.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Where data is stored: database (PostgreSQL in Docker) or json (data/*.json)
STORAGE_BACKEND=database

# PostgreSQL connection (also used by docker-compose.yaml)
POSTGRES_DB=devtrack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
